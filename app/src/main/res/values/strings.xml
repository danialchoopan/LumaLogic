    <!-- About & Credits -->
    <string name="about_created_by">Created by Danial Choopan</string>
    <string name="about_version">Version 1.0.5</string>
    <string name="about_desc">LumaLogic is a optical logic puzzle game. Route light beams across grid matrices using mirrors, splitters, RGB filters, and logic gates.</string>

    <!-- Tutorials -->
    <string name="tutorial_intro_title">Welcome to LumaLogic</string>
    <string name="tutorial_intro_desc">Route laser light from Sources to Target receptors to clear each grid puzzle.</string>
    <string name="tutorial_mirror_title">Mirrors &amp; Splitters</string>
    <string name="tutorial_mirror_desc">Tap elements to rotate them 90 degrees. Mirrors deflect light at right angles; Splitters duplicate beams.</string>
    <string name="tutorial_filter_title">RGB Filters &amp; Colors</string>
    <string name="tutorial_filter_desc">Filters pass matching light colors. Mix Primary Red, Green, and Blue to create Yellow, Magenta, Cyan, and White light.</string>
    <string name="tutorial_gate_title">Optical Logic Gates</string>
    <string name="tutorial_gate_desc">AND gates require multi-beam conjunctions. OR gates pass any beam. NOT gates invert active light signals.</string>
    <string name="tutorial_energy_title">Energy Thrift &amp; Stars</string>
    <string name="tutorial_energy_desc">Every rotation consumes energy. Complete puzzles in fewer moves to earn up to 3 Stars!</string>
